# --- Varsayılan: docker-compose'daki SQL Server container'ı (SQL kimlik doğrulama) ---
# docker compose up ile ayağa kalkan container için bunlar zaten doğru;
# host dışından/Docker olmadan çalıştırırken de aynı DSN'ler geçerlidir.
DATABASE_URL=mssql+aioodbc://sa:CoWork!2024Strong@localhost:1433/ai_usage_maturity?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&MARS_Connection=yes
DATABASE_URL_SYNC=mssql+pyodbc://sa:CoWork!2024Strong@localhost:1433/ai_usage_maturity?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes&MARS_Connection=yes

# --- Alternatif: kendi bilgisayarınızdaki yerel SQL Server Express'e Windows
# kimlik doğrulamasıyla bağlanmak isterseniz (SADECE kendi makinenizde
# çalışır, Docker container'ları için kullanılamaz -- Windows Auth taşınabilir
# değildir). Yukarıdaki iki satırı yorumlayıp bunları açın:
# DATABASE_URL=mssql+aioodbc://@DESKTOP-49MB5G3\SQLEXPRESS/ai_usage_maturity?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes&MARS_Connection=yes
# DATABASE_URL_SYNC=mssql+pyodbc://@DESKTOP-49MB5G3\SQLEXPRESS/ai_usage_maturity?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes&MARS_Connection=yes

API_BASE_URL=http://localhost:8000
SCHEDULER_ENABLED=true
SCORE_RECOMPUTE_INTERVAL_MINUTES=5
QUALITY_AUDIT_INTERVAL_MINUTES=15
